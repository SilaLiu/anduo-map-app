{
  "name": "anduo-map-app",
  "version": "1.0.0",
  "description": "安多县三维地理沙盘 - 卫星影像、标注、任务清单与地物提取",
  "author": "Teddy <qingyiliu0@gmail.com>",
  "scripts": {
    "prestart": "node scripts/prepare-web-data.mjs",
    "predev": "node scripts/prepare-web-data.mjs",
    "prebuild": "node scripts/prepare-web-data.mjs",
    "start": "vite --host 127.0.0.1",
    "dev": "vite --host 127.0.0.1",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "vue-tsc --noEmit",
    "format": "prettier --write src/web tests vite.config.ts vitest.config.ts playwright.config.ts",
    "pretest": "node scripts/prepare-web-data.mjs",
    "test": "vitest run",
    "test:boundaries": "python3 -m unittest discover -s tests/python -v",
    "test:e2e": "playwright test",
    "download:china-geojson": "python3 scripts/download-china-admin-geojson.py",
    "setup:python": "python3 -m venv .venv && .venv/bin/pip install -r requirements.txt",
    "fetch:map-data": ".venv/bin/python scripts/fetch_map_data_scrapling.py",
    "fetch:map-data:anduo": ".venv/bin/python scripts/fetch_map_data_scrapling.py --scope anduo",
    "fetch:map-data:china": ".venv/bin/python scripts/fetch_map_data_scrapling.py --scope china"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^24.0.0",
    "@vitejs/plugin-vue": "^6.0.0",
    "prettier": "^3.9.6",
    "typescript": "^5.9.0",
    "vite": "^7.1.0",
    "vite-plugin-static-copy": "^3.1.0",
    "vitest": "^3.2.0",
    "vue-tsc": "^3.0.0"
  },
  "dependencies": {
    "@turf/turf": "^7.2.0",
    "cesium": "^1.133.0",
    "idb-keyval": "^6.2.2",
    "lucide-vue-next": "^0.468.0",
    "vue": "^3.5.0"
  },
  "packageManager": "pnpm@10.33.1+sha512.05ba3c1d5d1c18f68df06470d74055e62d41fc110a0c660db1b2dfb2785327f04cf0f68345d4609bc52089e7fa0343c31593b2f9594e2c5d5da426230acc9820"
}
