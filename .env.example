# Optional, all VITE_* values are public in the browser build.
# A Cesium quantized-mesh terrain service with CORS enabled:
VITE_TERRAIN_URL=
# Alternatively use Cesium ion terrain (requires your own token):
VITE_CESIUM_ION_TOKEN=
VITE_IMAGERY_URL=
VITE_IMAGERY_CREDIT=
VITE_TIANDITU_KEY=
# AMap JS API 2.0 browser key (not a Web service key):
VITE_AMAP_JS_KEY=

# Server only. Never prefix this secret with VITE_. Run pnpm routing separately.
AMAP_WEB_KEY=
# JS API security code, injected only by the server-side /_AMapService proxy:
AMAP_SECURITY_JSCODE=
